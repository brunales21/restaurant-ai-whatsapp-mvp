# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Twilio WhatsApp Sandbox (lo usa mcp-client)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# IMPORTANTE:
# Si levantas todo con docker compose, NO apuntes RESTAURANT_MCP_SERVER_URL a ngrok.
# mcp-client debe hablar con mcp-server por la red interna de Docker:
RESTAURANT_MCP_SERVER_URL=http://mcp-server:8080
RESTAURANT_MCP_SERVER_ENDPOINT=/mcp

# Ngrok/cloudflared se usa solo para que Twilio alcance el cliente:
#   ngrok http 8081
#   Twilio webhook -> https://TU_NGROK/webhooks/twilio
